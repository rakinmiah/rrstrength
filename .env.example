# RR Strength — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.

# Resend API key (https://resend.com). Unset in dev, the form works but sends
# nothing (warned on the server console). Unset in production, the form fails
# visibly rather than silently dropping the enquiry.
RESEND_API_KEY=

# Verified sending address on your Resend domain (falls back to Resend's
# shared test sender for local dev).
RESEND_FROM="RR Strength <noreply@rrstrength.com>"

# Destination inbox for enquiries/intake (defaults to the current Gmail).
RR_INBOX=rashedrahman382@gmail.com
